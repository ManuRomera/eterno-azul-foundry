<section class="ea-body">{{#unless limited}}<nav class="ea-tabs" aria-label="Secciones"><button type="button" data-action="tab" data-tab="play" aria-pressed="{{play}}">{{#if isShip}}Navegación{{else}}En juego{{/if}}</button><button type="button" data-action="tab" data-tab="inventory" aria-pressed="{{inventory}}">{{#if isShip}}Bodega y armamento{{else}}Pertrechos y magia{{/if}}</button><button type="button" data-action="tab" data-tab="notes" aria-pressed="{{notes}}">Historia y ajustes</button><button type="button" data-action="compact" aria-label="Cambiar densidad">↔</button></nav>
{{#if play}}<div class="ea-layout"><aside class="ea-sidebar">{{#if isPC}}<div class="ea-section-heading"><h3>Señas</h3><button type="button" data-action="create" data-type="sena" aria-label="Añadir Seña">＋</button></div>{{#each signs}}<div class="ea-sign" data-item-id="{{id}}"><button type="button" data-action="edit"><strong>{{name}}</strong><span>d{{system.die}}</span></button></div>{{/each}}<p class="ea-muted">Sin Seña aplicable: +1d6</p><div class="ea-section-heading"><h3>Vínculos</h3><button type="button" data-action="create" data-type="vinculo" aria-label="Añadir Vínculo">＋</button></div>{{#each bonds}}<div class="ea-bond" data-item-id="{{id}}"><button type="button" data-action="edit">{{name}}</button><button type="button" data-action="toggle" data-path="exhausted">{{#if system.exhausted}}Agotado · recuperar{{else}}Disponible{{/if}}</button></div>{{/each}}<p class="ea-muted">Arrastra otro Actor para crear un Vínculo. Úsalo desde su Desafío.</p>{{/if}}{{#if isNPC}}<label>Amenaza<input type="number" min="0" name="system.threat" value="{{system.threat}}"></label><p class="ea-muted">La DJ no tira dados. La Amenaza orienta el Riesgo de los Buscadores.</p>{{/if}}{{#if isShip}}<button type="button" class="ea-primary" data-action="naval">Abrir consola naval</button><h3>Tripulación</h3>{{#each system.crew}}<p>{{name}} · {{role}} {{#if present}}✓{{/if}}</p>{{/each}}<p class="ea-muted">Arrastra Actors para embarcarlos.</p><label>Corazón actual<input type="number" min="0" name="system.heart.value" value="{{system.heart.value}}"></label><label>Corazón total<input type="number" min="0" name="system.heart.max" value="{{system.heart.max}}"></label>{{/if}}</aside><main class="ea-main">{{#if isPC}}<h2>¿Qué haces?</h2><div class="ea-actions">{{#each actions}}<div class="ea-action"><button type="button" data-action="roll" data-key="{{key}}" title="Tirar · Mayús para reserva manual">{{label}}</button><button type="button" class="ea-die-select" data-action="die" data-key="{{key}}" aria-label="Cambiar dado de {{label}}">d{{die}}</button></div>{{/each}}</div>{{/if}}{{#if isShip}}<div class="ea-instruments">{{#each shipStats}}<label>{{label}}<input type="number" min="0" name="system.{{key}}" value="{{value}}"></label>{{/each}}</div><label>Estado<input name="system.state" value="{{system.state}}"></label>{{/if}}{{#if isNPC}}<label>Rasgos<textarea name="system.traits">{{system.traits}}</textarea></label><label>Acciones características<textarea name="system.characteristicActions">{{system.characteristicActions}}</textarea></label><label>Ataques y consecuencias<textarea name="system.attacks">{{system.attacks}}</textarea></label>{{/if}}<div class="ea-health">{{#unless isShip}}<label>Aguante<input type="number" min="0" name="system.stamina" value="{{system.stamina}}"></label>{{/unless}}<label>Daño acumulado<input type="number" min="0" name="system.damage" value="{{system.damage}}"></label>{{#if isPC}}<label>Defensa actual<input type="number" min="0" name="system.defense.value" value="{{system.defense.value}}"></label><label>Defensa total<input type="number" min="0" name="system.defense.max" value="{{system.defense.max}}"></label>{{/if}}</div>{{#if system.out}}<p class="ea-danger">Fuera de combate · el daño supera el umbral</p>{{/if}}<div class="ea-grid"><button type="button" data-action="damage">Gestionar daño</button>{{#if isPC}}<button type="button" data-action="rest">Tomar un descanso</button>{{/if}}</div><details open data-section="conditions"><summary>Heridas, condiciones y desperfectos</summary><button type="button" data-action="create" data-type="condicion">Añadir Condición</button>{{#each conditions}}<div class="ea-list-row" data-item-id="{{id}}"><button type="button" data-action="edit">{{name}} · {{system.severity}}{{system.intensity}}</button><button type="button" data-action="remove" aria-label="Eliminar {{name}}">×</button></div>{{/each}}</details><details open data-section="features"><summary>Aptitudes y capacidades</summary><button type="button" data-action="create" data-type="aptitud">Añadir Aptitud</button>{{#each features}}<div class="ea-list-row" data-item-id="{{id}}"><button type="button" data-action="edit">{{name}}</button><button type="button" data-action="remove" aria-label="Eliminar {{name}}">×</button></div>{{/each}}</details></main></div>{{/if}}
{{#if inventory}}<div class="ea-section-heading"><h2>{{#if isShip}}Bodega{{else}}Pertrechos{{/if}}</h2><span>Bulto {{system.bulk}}{{#if isPC}} / 10{{/if}}</span><button type="button" data-action="create">Añadir</button></div><input type="search" data-ea-search placeholder="Buscar por nombre, tipo o etiqueta" aria-label="Buscar inventario"><div class="ea-inventory">{{#each items}}<details data-inventory-row class="draggable" data-item-id="{{id}}"><summary><img src="{{img}}" alt=""><strong>{{name}}</strong><small>{{type}} · ×{{system.quantity}} · {{system.bulk}} bulto</small></summary><p>{{system.description}}</p><p>{{system.tags}} · Usos {{system.uses.value}} / {{system.uses.max}}</p><div class="ea-grid"><button type="button" data-action="edit">Editar</button><button type="button" data-action="toggle" data-path="equipped">{{#if system.equipped}}Equipado{{else}}Equipar{{/if}}</button><button type="button" data-action="remove">Eliminar</button></div></details>{{/each}}</div>{{#if isPC}}<div class="ea-grid"><label>Botín<input name="system.loot" type="number" value="{{system.loot}}" min="0"></label><label>Equipo de Buscador disponible<input name="system.kit.value" type="number" min="0" max="5" value="{{system.kit.value}}"></label></div><p class="ea-muted">Materializar equipo requiere una casilla disponible, espacio y acuerdo de la DJ.</p>{{/if}}<h3>Magia y capacidades</h3>{{#each features}}<div class="ea-list-row" data-item-id="{{id}}"><button type="button" data-action="edit">{{name}}</button><button type="button" data-action="remove">Eliminar</button></div>{{/each}}{{/if}}
{{#if notes}}{{#if isPC}}<label>Biografía<textarea name="system.biography">{{system.biography}}</textarea></label><label>Trasfondo<textarea name="system.background">{{system.background}}</textarea></label><label>Bríos actuales<input name="system.brio.value" type="number" min="0" value="{{system.brio.value}}"></label><label>Navío (UUID)<input name="system.shipUuid" value="{{system.shipUuid}}"></label>{{else}}<label>Descripción<textarea name="system.description">{{system.description}}</textarea></label>{{/if}}{{#if isShip}}<label>Carga<textarea name="system.cargo">{{system.cargo}}</textarea></label><label>Víveres<textarea name="system.supplies">{{system.supplies}}</textarea></label><label>Viajeros<textarea name="system.passengers">{{system.passengers}}</textarea></label>{{/if}}<label>Notas compartidas con observadores<textarea name="system.notes">{{system.notes}}</textarea></label><p class="ea-muted">Guarda secretos de DJ en un Diario con permisos privados. La ocultación visual de un campo no sustituye los permisos de Foundry.</p>{{/if}}{{else}}<p>El propietario no ha compartido los detalles de esta ficha.</p>{{/unless}}</section>
