<header class="ea-header ea-header-{{type}}">
<img src="{{img}}" data-action="editImage" data-edit="img" alt="Retrato" tabindex="0">
<div class="ea-identity">
<p class="ea-eyebrow">ETERNO AZUL · {{type}}</p>
<input class="ea-name" name="name" value="{{name}}" aria-label="Nombre" {{#unless editable}}disabled{{/unless}}>{{#unless limited}}
{{#if isPC}}<div class="ea-grid">
<label>Origen<button type="button" data-action="identity" data-key="origin">{{#if origin}}
{{origin.name}}
{{else}}Elegir Origen{{/if}}</button>
</label>
<label>Arquetipo<button type="button" data-action="identity" data-key="archetype">{{#if archetype}}
{{archetype.name}}
{{else}}Elegir Arquetipo{{/if}}</button>
</label>
</div>{{/if}}
{{#if isShip}}<label>Clase<input name="system.class" value="{{system.class}}">
</label>{{/if}}
{{/unless}}</div>{{#if isPC}}
{{#unless limited}}<button type="button" class="ea-brio" data-action="brio" aria-label="Usar Bríos">
<span>BRÍOS · {{system.brio.value}}</span>
<span class="ea-pips">{{#each pips}}<span class="ea-pip {{#if filled}}filled{{/if}}">{{#if filled}}◆{{else}}◇{{/if}}</span>{{/each}}</span>
</button>{{/unless}}
{{/if}}</header>
