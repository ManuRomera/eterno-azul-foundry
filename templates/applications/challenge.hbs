<section class="ea-body ea-dialog"><p class="ea-eyebrow">{{actor}} · DESAFÍO</p><div class="ea-grid"><label>Acción<select name="action">{{#each actions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Seña<select name="signId"><option value="">Sin Seña · d6</option>{{#each signs}}<option value="{{id}}">{{name}} · d{{die}}</option>{{/each}}</select></label></div><div class="ea-grid"><label>Copias del dado de Acción<input name="copies" type="number" min="1" max="100" value="1"></label><label>Riesgo<input name="risk" type="number" min="0" value="{{risk}}"></label><label>Aumentos (+) / reducciones (−)<input name="shifts" type="number" min="-20" max="20" value="{{shifts}}"></label></div><details open><summary>Aptitudes y Heridas aplicables</summary>{{#each effects}}<label class="ea-check"><input name="effect" value="{{id}}" type="checkbox">{{name}} <small>{{trigger}}</small></label>{{/each}}{{#each wounds}}<label class="ea-check"><input name="wound" value="{{id}}" type="checkbox">Reducción: {{name}}</label>{{/each}}</details><details><summary>Fuentes de Ventaja</summary><div class="ea-grid"><label>Pertrecho<input name="gear" placeholder="Herramienta que ayuda"></label><label>Condición<input name="condition" placeholder="Situación aprovechable"></label><label>Apoyo aliado<input name="ally" placeholder="Quién te ayuda"></label><label>Circunstancia<input name="circumstance" placeholder="Acordada con la DJ"></label></div></details><label>Bravata · consecuencia aceptada<input name="bravata" placeholder="Vacío si no declaras Bravata"></label><label>Contexto<input name="context" value="{{context}}"></label><details {{#if manual}}open{{/if}}><summary>Reserva manual · Mayús + clic</summary><label class="ea-check"><input name="manual" type="checkbox" {{checked manual}}>Usar dados manuales</label><label>Dados separados por espacios<input name="dice" value="d6 d6" placeholder="d4 d8 d10"></label></details><label>Visibilidad<select name="rollMode"><option value="publicroll">Pública</option><option value="gmroll">DJ y tú</option><option value="blindroll">Solo DJ</option><option value="selfroll">Privada</option></select></label><output class="ea-pool-preview" data-preview aria-live="polite"></output><p class="ea-muted">Un aliado puede agotar su Vínculo contigo desde el resultado para darte +1 éxito.</p><div class="ea-grid"><button type="submit" class="ea-primary">Lanzar Desafío</button><button type="button" data-action="forced">Aceptar fallo · ganar 1 Brío</button></div></section>
